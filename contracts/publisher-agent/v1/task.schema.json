{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto-content.local/contracts/publisher-agent/v1/task.schema.json",
  "title": "WeChat Moments Publisher Task v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "specVersion",
    "taskId",
    "idempotencyKey",
    "revision",
    "createdAt",
    "priority",
    "schedule",
    "target",
    "content",
    "policy",
    "extensions"
  ],
  "properties": {
    "specVersion": {
      "const": "wechat-moments-publisher/task-v1"
    },
    "taskId": {
      "$ref": "#/$defs/opaqueId"
    },
    "idempotencyKey": {
      "$ref": "#/$defs/opaqueId"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "priority": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "schedule": {
      "type": "object",
      "additionalProperties": true,
      "required": ["notBefore", "expiresAt", "timezone", "misfirePolicy"],
      "properties": {
        "notBefore": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "misfirePolicy": {
          "enum": ["skip", "publish_asap", "manual"]
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": true,
      "required": ["platform", "accountKey", "visibility"],
      "properties": {
        "platform": {
          "const": "wechat_moments"
        },
        "accountKey": {
          "$ref": "#/$defs/opaqueId"
        },
        "nickname": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "wechatId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "visibility": {
          "type": "object",
          "additionalProperties": true,
          "required": ["type"],
          "properties": {
            "type": {
              "const": "public"
            }
          }
        }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": true,
      "required": ["text", "media"],
      "properties": {
        "text": {
          "type": "string",
          "maxLength": 5000
        },
        "media": {
          "type": "array",
          "minItems": 1,
          "maxItems": 9,
          "items": {
            "$ref": "#/$defs/mediaItem"
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": true,
      "required": ["maxPreClickAttempts", "requirePostPublishConfirmation"],
      "properties": {
        "maxPreClickAttempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "requirePostPublishConfirmation": {
          "const": true
        }
      }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "opaqueId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "mediaItem": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "mediaId",
        "type",
        "mimeType",
        "fileName",
        "sizeBytes",
        "sha256",
        "downloadUrl"
      ],
      "properties": {
        "mediaId": {
          "$ref": "#/$defs/opaqueId"
        },
        "type": {
          "const": "image"
        },
        "mimeType": {
          "enum": ["image/jpeg", "image/png"]
        },
        "fileName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20971520
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "downloadUrl": {
          "type": "string",
          "format": "uri",
          "maxLength": 4096
        }
      }
    }
  }
}
