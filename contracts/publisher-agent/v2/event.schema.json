{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto-content.local/contracts/publisher-agent/v2/event.schema.json",
  "type": "object",
  "required": ["specVersion", "eventId", "taskId", "idempotencyKey", "leaseToken", "agentId", "instanceId", "executorInstanceId", "type", "attempt", "occurredAt", "details"],
  "properties": {
    "specVersion": { "const": "content-publisher/event-v2" },
    "eventId": { "type": "string", "minLength": 1 },
    "taskId": { "type": "string", "minLength": 1 },
    "idempotencyKey": { "type": "string", "minLength": 1 },
    "leaseToken": { "type": "string", "minLength": 1 },
    "agentId": { "type": "string", "minLength": 1 },
    "instanceId": { "type": "string", "minLength": 1 },
    "executorInstanceId": { "type": "string", "minLength": 1 },
    "type": {
      "enum": ["accepted", "preflight_started", "action_started", "final_action_intent", "completion_started", "draft_created", "platform_processing", "published", "waiting_user_action", "failed", "uncertain"]
    },
    "attempt": { "type": "integer", "minimum": 1 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "details": {
      "type": "object",
      "required": ["stage", "message"],
      "properties": {
        "stage": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 }
      }
    },
    "result": {
      "type": ["object", "null"],
      "properties": {
        "output": {
          "type": ["object", "null"],
          "properties": {
            "syncId": { "type": "string" },
            "postId": { "type": "string" },
            "postUrl": { "type": "string", "format": "uri" },
            "draftOnly": { "type": "boolean" }
          }
        },
        "error": {
          "type": ["object", "null"],
          "required": ["code", "stage", "retryable", "message"],
          "properties": {
            "code": { "type": "string", "minLength": 1 },
            "stage": { "type": "string", "minLength": 1 },
            "retryable": { "type": "boolean" },
            "message": { "type": "string", "minLength": 1 }
          }
        },
        "evidence": { "type": "array", "items": { "type": "object" } }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "draft_created" } } },
      "then": {
        "required": ["result"],
        "properties": {
          "result": {
            "type": "object",
            "required": ["output"],
            "properties": {
              "output": {
                "type": "object",
                "required": ["draftOnly"],
                "properties": { "draftOnly": { "const": true } }
              }
            }
          }
        }
      }
    }
  ]
}
